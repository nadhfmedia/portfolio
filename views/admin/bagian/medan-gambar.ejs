<%
  // Medan unggah gambar beserta pratinjaunya.
  // Saat gambar sudah ada atau baru dipilih, kotak seret-lepas disembunyikan
  // dan digantikan langsung oleh pratinjau gambar dengan tombol silang (×).
  var namaMedanIni = typeof namaMedan !== 'undefined' && namaMedan ? namaMedan : nama;
  var lewatiPopup = typeof tanpaPopup !== 'undefined' && tanpaPopup;
  var urlAwal = gambarLama ? (gambarLama.startsWith('http') ? gambarLama : '/' + gambarLama) : '';
%>
<div class="medan" data-medan-gambar data-gambar-awal="<%= urlAwal %>">
  <label for="<%= nama %>"><%= label %></label>

  <label class="zona-unggah" data-zona-unggah for="<%= nama %>" <% if (urlAwal) { %>hidden<% } %>>
    <input type="file" id="<%= nama %>" name="<%= namaMedanIni %>" class="zona-unggah-masukan"
      accept=".jpg,.jpeg,.png,.webp,.gif" data-pratinjau-medan>
    <span class="zona-unggah-ikon" aria-hidden="true"><i class="bx bx-cloud-upload"></i></span>
    <span class="zona-unggah-teks">
      <span class="zona-unggah-judul">Seret &amp; lepas gambar ke sini, atau <u>klik untuk memilih</u></span>
      <span class="zona-unggah-sub">Format: jpg, jpeg, png, webp, gif. Maksimal 5 MB.</span>
    </span>
  </label>

  <div class="media-terpilih" data-pratinjau-kotak <% if (!urlAwal) { %>hidden<% } %>>
    <img src="<%= urlAwal %>" alt="" class="pratinjau" data-pratinjau-gambar>
    <button type="button" class="media-hapus-bulat" data-pratinjau-batal aria-label="Hapus atau ganti gambar" title="Hapus gambar">
      <i class="bx bx-x"></i>
    </button>
  </div>
</div>

<% if (!lewatiPopup) { %>
<%- include('popup-gambar') %>
<% } %>
