<div class="kartu kartu-sempit">
  <form method="post" action="/admin/akun" enctype="multipart/form-data" id="form-akun">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="hapus_foto" id="hapus_foto_medan" value="">

    <div class="medan">
      <span class="label">Foto profil</span>
      <div class="akun-foto-baris">
        <div class="media-terpilih media-terpilih-bulat" id="akun-foto-kotak" <% if (!akun.foto) { %>hidden<% } %>>
          <img src="<%= akun.foto ? (akun.foto.startsWith('http') ? akun.foto : '/' + akun.foto) : '' %>" alt="" class="akun-foto" id="akun-foto-tayang">
          <button type="button" class="media-hapus-bulat" id="akun-foto-hapus" aria-label="Hapus foto profil" title="Hapus foto profil">
            <i class="bx bx-x"></i>
          </button>
        </div>
        <span class="akun-foto akun-huruf" id="akun-huruf-awal" <% if (akun.foto) { %>hidden<% } %>><%= (akun.nama || '?').trim().charAt(0).toUpperCase() %></span>

        <div class="akun-foto-teks" style="flex: 1; min-width: 220px;">
          <label class="zona-unggah" data-zona-unggah for="foto">
            <input type="file" id="foto" name="foto" class="zona-unggah-masukan" accept=".jpg,.jpeg,.png,.webp,.gif">
            <span class="zona-unggah-ikon" aria-hidden="true"><i class="bx bx-cloud-upload"></i></span>
            <span class="zona-unggah-teks">
              <span class="zona-unggah-judul">Seret &amp; lepas foto ke sini, atau <u>klik untuk memilih</u></span>
              <span class="zona-unggah-sub">Format: jpg, jpeg, png, webp, gif. Maksimal 5 MB.</span>
            </span>
          </label>
        </div>
      </div>
    </div>

    <!-- Elemen tersembunyi untuk kompatibilitas pemangkas di admin.js -->
    <div id="pangkas-hasil" hidden>
      <img src="" alt="" id="pangkas-hasil-gambar" hidden>
      <span id="pangkas-hasil-nama" hidden></span>
      <button type="button" id="pangkas-hasil-batal" hidden></button>
    </div>

    <p class="kesalahan" id="pangkas-gagal" hidden></p>

    <div class="medan">
      <label for="nama">Nama</label>
      <input type="text" id="nama" name="nama" value="<%= akun.nama %>" required maxlength="120">
    </div>

    <div class="medan">
      <label for="email">Email</label>
      <input type="text" id="email" value="<%= akun.email %>" disabled>
      <p class="petunjuk">Email belum bisa diubah di tahap ini.</p>
    </div>

    <div class="tombol-baris">
      <button type="submit" class="tombol"><i class="bx bx-save"></i> Simpan</button>
      <a href="/admin" class="tombol tombol-samar">Batal</a>
    </div>
  </form>
</div>

<!-- ===== Ubah sandi ===== -->
<div class="kartu kartu-sempit">
  <h2>Ubah sandi</h2>

  <% if (typeof kesalahanSandi !== 'undefined' && kesalahanSandi) { %>
  <p class="kesalahan"><%= kesalahanSandi %></p>
  <% } %>

  <form method="post" action="/admin/akun/sandi" autocomplete="off">
    <input type="hidden" name="_csrf" value="<%= csrf %>">

    <div class="medan">
      <label for="sandi_lama">Sandi sekarang</label>
      <div class="sandi-bungkus">
        <input type="password" id="sandi_lama" name="sandi_lama" required
          autocomplete="current-password">
      </div>
    </div>

    <div class="medan-kisi">
      <div class="medan">
        <label for="sandi_baru">Sandi baru</label>
        <div class="sandi-bungkus">
          <input type="password" id="sandi_baru" name="sandi_baru" required minlength="10"
            autocomplete="new-password">
        </div>
      </div>

      <div class="medan">
        <label for="sandi_ulang">Ulangi sandi baru</label>
        <div class="sandi-bungkus">
          <input type="password" id="sandi_ulang" name="sandi_ulang" required minlength="10"
            autocomplete="new-password">
        </div>
      </div>
    </div>

    <p class="petunjuk">
      Sandi baru minimal 10 karakter dan tidak boleh sama dengan sandi sekarang.
      Setelah berhasil diubah, sesi lama dibatalkan tapi Anda tetap masuk di peramban ini.
    </p>

    <div class="tombol-baris">
      <button type="submit" class="tombol"><i class="bx bx-lock-alt"></i> Ubah sandi</button>
    </div>
  </form>

  <p class="petunjuk" style="margin-top: 14px;">
    Lupa sandi sekarang? <a href="/admin/lupa-sandi">Kirim tautan atur ulang sandi ke email Anda.</a>
  </p>
</div>

<!-- ===== Popup: atur foto profil ===== -->
<div class="tirai" id="popup-pangkas" hidden>
  <div class="popup popup-pangkas" role="dialog" aria-modal="true" aria-labelledby="pangkas-judul">
    <div class="popup-atas">
      <h2 id="pangkas-judul">Atur foto profil</h2>
      <button type="button" class="tutup" data-tutup aria-label="Tutup"><i class="bx bx-x"></i></button>
    </div>

    <div class="popup-isi">
      <div class="pangkas-area">
        <canvas id="pangkas-kanvas" width="320" height="320"
          aria-label="Seret untuk menggeser foto"></canvas>
        <div class="pangkas-lingkaran" aria-hidden="true"></div>
      </div>

      <div class="pangkas-alat">
        <label for="pangkas-zum" class="pangkas-zum-label"><i class="bx bx-zoom-in"></i></label>
        <input type="range" id="pangkas-zum" min="100" max="300" value="100" step="1"
          aria-label="Perbesar foto">
        <button type="button" class="tombol tombol-samar tombol-kecil" id="pangkas-atur-ulang">
          <i class="bx bx-reset"></i> Atur ulang
        </button>
      </div>

      <div class="pangkas-bawahan" hidden>
        <canvas id="pangkas-pratinjau" width="64" height="64" aria-hidden="true"></canvas>
        <div class="pangkas-keterangan">
          <p class="petunjuk" id="pangkas-berkas-nama"></p>
          <p class="petunjuk" id="pangkas-berkas-ukuran"></p>
        </div>
      </div>

      <p class="petunjuk">
        Seret gambarnya untuk menggeser. Pakai penggeser, roda tetikus, atau cubitan dua
        jari untuk memperbesar.
      </p>
    </div>

    <div class="popup-bawah">
      <button type="button" class="tombol" id="pangkas-pakai"><i class="bx bx-check"></i> Pakai foto ini</button>
      <button type="button" class="tombol tombol-samar" id="pangkas-batal">Batal</button>
    </div>
  </div>
</div>
