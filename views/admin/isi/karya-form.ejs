<div class="kartu kartu-sempit">
  <form method="post" action="<%= aksi %>" enctype="multipart/form-data" id="form-karya">
    <input type="hidden" name="_csrf" value="<%= csrf %>">

    <div class="medan">
      <label for="judul">Judul</label>
      <input type="text" id="judul" name="judul" value="<%= nilai.judul || '' %>" required maxlength="200">
    </div>

    <div class="medan">
      <label for="subjudul">Subjudul</label>
      <input type="text" id="subjudul" name="subjudul" value="<%= nilai.subjudul || '' %>" maxlength="200">
    </div>

    <div class="medan">
      <label for="kategori_id">Kategori</label>
      <select id="kategori_id" name="kategori_id">
        <option value="">— tanpa kategori —</option>
        <% kategori.forEach(function (kat) { %>
        <option value="<%= kat.id %>" <%= String(nilai.kategori_id) === String(kat.id) ? 'selected' : '' %>>
          <%= kat.nama %>
        </option>
        <% }); %>
      </select>
    </div>

    <div class="medan">
      <label for="urutan">Urutan</label>
      <input type="number" id="urutan" name="urutan" value="<%= nilai.urutan %>" min="0" step="1">
      <p class="petunjuk">Angka lebih kecil tampil lebih dulu.</p>
    </div>

    <%- include('../bagian/sakelar-form', {
      nama: 'tampil',
      label: 'Tampilkan karya ini di situs',
      dicentang: Number(nilai.tampil) === 1
    }) %>

    <%- include('../bagian/medan-gambar', {
      nama: 'gambar',
      label: 'Gambar',
      gambarLama: nilai.gambar || ''
    }) %>

    <%
      var videoAwal = nilai.video ? (nilai.video.startsWith('http') ? nilai.video : '/' + nilai.video) : '';
    %>
    <div class="medan" data-video-medan data-csrf="<%= csrf %>" data-tanda="/admin/karya/tanda-tangan-video" data-video-awal="<%= videoAwal %>">
      <label for="video-berkas">Video (opsional)</label>

      <input type="hidden" name="video_url" value="" data-video-url>
      <input type="hidden" name="hapus_video" value="" data-video-hapus>

      <label class="zona-unggah" data-zona-unggah for="video-berkas" <% if (videoAwal) { %>hidden<% } %>>
        <input type="file" id="video-berkas" class="zona-unggah-masukan" accept=".mp4,.webm,.mov,video/mp4,video/webm,video/quicktime" data-video-berkas>
        <span class="zona-unggah-ikon" aria-hidden="true"><i class="bx bx-video-plus"></i></span>
        <span class="zona-unggah-teks">
          <span class="zona-unggah-judul">Seret &amp; lepas video ke sini, atau <u>klik untuk memilih</u></span>
          <span class="zona-unggah-sub">Format: mp4, webm, mov. Maksimal 100 MB.</span>
        </span>
      </label>

      <div class="media-terpilih media-terpilih-video" data-video-kotak <% if (!videoAwal) { %>hidden<% } %>>
        <video src="<%= videoAwal %>" controls preload="metadata" class="video-pratinjau" data-video-pratinjau></video>
        <button type="button" class="media-hapus-bulat" data-video-batal aria-label="Hapus video" title="Hapus video">
          <i class="bx bx-x"></i>
        </button>
      </div>

      <div class="video-kemajuan" data-video-kemajuan hidden>
        <div class="video-kemajuan-isi" data-video-isi></div>
      </div>
      <p class="petunjuk" data-video-status hidden></p>
    </div>

    <div class="tombol-baris">
      <button type="submit" class="tombol"><i class="bx bx-save"></i> Simpan</button>
      <a href="/admin/karya" class="tombol tombol-samar" data-batal-form>Batal</a>
    </div>
  </form>
</div>
