<div class="kartu kartu-sempit">
  <form method="post" action="<%= aksi %>" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrf %>">

    <% if (typeof nilai.dibuat_pada !== 'undefined') { %>
    <p class="petunjuk">
      Tanggal:
      <% if (nilai.dibuat_pada) { %><strong><%= tanggalIndonesia(nilai.dibuat_pada) %></strong><% } else { %>
      tidak tercatat — karya ini sudah ada sebelum tanggal unggah mulai disimpan<% } %>
    </p>
    <% } %>

    <div class="medan">
      <label for="judul">Judul</label>
      <input type="text" id="judul" name="judul" value="<%= nilai.judul || '' %>" required maxlength="200">
    </div>

    <div class="medan">
      <label for="subjudul">Subjudul</label>
      <input type="text" id="subjudul" name="subjudul" value="<%= nilai.subjudul || '' %>" maxlength="200">
    </div>

    <div class="medan">
      <label for="kategori_id">Kategori</label>
      <select id="kategori_id" name="kategori_id">
        <option value="">— tanpa kategori —</option>
        <% kategori.forEach(function (kat) { %>
        <option value="<%= kat.id %>" <%= String(nilai.kategori_id) === String(kat.id) ? 'selected' : '' %>>
          <%= kat.nama %>
        </option>
        <% }); %>
      </select>
    </div>

    <div class="medan">
      <label for="urutan">Urutan</label>
      <input type="number" id="urutan" name="urutan" value="<%= nilai.urutan %>" min="0" step="1">
      <p class="petunjuk">Angka lebih kecil tampil lebih dulu.</p>
    </div>

    <%- include('../bagian/sakelar-form', {
      nama: 'tampil',
      label: 'Tampilkan karya ini di situs',
      dicentang: Number(nilai.tampil) === 1
    }) %>

    <%- include('../bagian/medan-gambar', {
      nama: 'gambar',
      label: 'Gambar',
      gambarLama: nilai.gambar || ''
    }) %>

    <div class="medan" data-video-medan data-csrf="<%= csrf %>" data-tanda="/admin/karya/tanda-tangan-video">
      <label for="video-berkas">Video (opsional)</label>

      <% if (nilai.video) { %>
      <div class="pratinjau-lama">
        <video src="<%= nilai.video %>" controls preload="metadata" class="video-pratinjau"></video>
        <p class="petunjuk">Video sekarang</p>
        <label class="video-hapus">
          <input type="checkbox" name="hapus_video" value="1"> Hapus video ini
        </label>
      </div>
      <% } %>

      <input type="hidden" name="video_url" value="" data-video-url>
      <input type="file" id="video-berkas" accept=".mp4,.webm,.mov,video/mp4,video/webm,video/quicktime" data-video-berkas>

      <div class="video-kemajuan" data-video-kemajuan hidden>
        <div class="video-kemajuan-isi" data-video-isi></div>
      </div>
      <p class="petunjuk" data-video-status>
        Format: mp4, webm, mov. Maksimal 100 MB. Videonya langsung diunggah saat dipilih;
        tekan Simpan setelah selesai. Gambar di atas dipakai sebagai sampul video
        (kalau kosong, sampul diambil dari bingkai pertama video).
      </p>
    </div>

    <div class="tombol-baris">
      <button type="submit" class="tombol"><i class="bx bx-save"></i> Simpan</button>
      <a href="/admin/karya" class="tombol tombol-samar">Batal</a>
    </div>
  </form>
</div>
<script src="/admin-assets/video-unggah.js?v=1" defer></script>
