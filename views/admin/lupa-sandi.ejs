<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Lupa sandi — Panel Admin</title>
  <link rel="stylesheet" href="/admin-assets/boxicons/css/boxicons.min.css">
  <link rel="stylesheet" href="/admin-assets/admin.css">
</head>

<body>
  <div class="masuk-bingkai">
    <div class="masuk-kotak">
      <h1>Lupa sandi</h1>
      <p class="keterangan">
        Masukkan email akun Anda. Tautan untuk mengatur ulang sandi
        akan dikirim ke email tersebut.
      </p>

      <% if (berhasil) { %>
      <p class="berhasil"><%= berhasil %></p>
      <% } %>

      <% if (kesalahan) { %>
      <p class="kesalahan"><%= kesalahan %></p>
      <% } %>

      <% if (!berhasil) { %>
      <form method="post" action="/admin/lupa-sandi">
        <input type="hidden" name="_csrf" value="<%= csrf %>">

        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="username" required autofocus>

        <button type="submit" class="tombol tombol-penuh">Kirim tautan reset</button>
      </form>
      <% } %>

      <p class="masuk-bantuan"><a href="/admin/login"><i class="bx bx-arrow-back"></i> Kembali ke halaman masuk</a></p>
    </div>
  </div>
</body>

</html>
